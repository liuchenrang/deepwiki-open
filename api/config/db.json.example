{
  "vector_db": {
    "backend": "faiss",
    "faiss": {
      "index_path": "~/.adalflow/databases/",
      "embedding_dimension": 1024,
      "index_type": "Flat"
    },
    "pgvector": {
      "connection_string": "postgresql://deepwiki:deepwiki@localhost:5432/deepwiki",
      "embedding_dimension": 1024,
      "index_type": "hnsw",
      "index_parameters": {
        "m": 16,
        "ef_construction": 64
      },
      "pool_size": 10
    }
  }
}
